{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "app.dizko/events",
  "title": "Dizko",
  "description": "Live concerts, club nights, art, comedy, and festivals from Dizko.",
  "repository": {
    "url": "https://github.com/Dizko-Labs/dizko-mcp",
    "source": "github"
  },
  "version": "0.7.1",
  "websiteUrl": "https://www.dizko.app",
  "icons": [
    {
      "src": "https://mcp.dizko.app/logo-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.dizko.app/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "dizko-events",
      "version": "0.7.1",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Runs the stdio MCP server."
        }
      ]
    }
  ]
}
