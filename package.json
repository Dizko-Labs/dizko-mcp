{
  "name": "uplayground-events",
  "version": "0.3.2",
  "mcpName": "xyz.urbanplayground/events",
  "description": "CLI and MCP server for live Dizko event discovery.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./tools": "./src/tools.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "events",
    "event-discovery",
    "chatgpt",
    "claude",
    "dizko",
    "uplayground",
    "urbanplayground"
  ],
  "homepage": "https://www.dizko.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZakKrevitt/EventChat.git",
    "directory": "ios/EventChat/agent-tools/eventchat-events"
  },
  "bugs": {
    "url": "https://github.com/ZakKrevitt/EventChat/issues"
  },
  "bin": {
    "dizko-events": "bin/eventchat-events.js",
    "uplayground-events": "bin/eventchat-events.js",
    "eventchat-events": "bin/eventchat-events.js",
    "eventchat-events-http": "bin/eventchat-events-http.js",
    "eventchat-events-mcp": "bin/eventchat-events-mcp.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "public/*.html",
    "public/logo-512.png",
    "README.md",
    "USER_GUIDE.md",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node ./bin/eventchat-events-http.js",
    "smoke:live": "node ./scripts/smoke-live.mjs",
    "verify:submission": "node ./scripts/verify-submission.mjs",
    "verify:submission:write": "EVENTCHAT_SUBMISSION_EVIDENCE_PATH=./submission-evidence/latest.json node ./scripts/verify-submission.mjs",
    "verify:submission:summary": "node ./scripts/write-submission-summary.mjs",
    "verify:submission:bundle": "npm run verify:submission:write && npm run verify:submission:summary",
    "verify:submission:fields": "node ./scripts/validate-submission-fields.mjs",
    "submission:status": "node ./scripts/submission-status.mjs",
    "review:demo": "node ./scripts/write-review-demo.mjs",
    "preferences:delete": "node ./scripts/delete-preference-profile.mjs",
    "domain:check": "node ./scripts/check-custom-domain.mjs",
    "monitor:live": "node ./scripts/monitor-live.mjs",
    "build:mcpb": "node ./scripts/build-mcpb.mjs",
    "preflight:submission": "npm test && npm run smoke:live && npm run verify:submission:bundle && npm run verify:submission:fields",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}
